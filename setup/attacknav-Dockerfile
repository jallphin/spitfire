# Build stage: compile the MITRE ATT&CK Navigator (Angular app) for production
FROM node:22 AS build
WORKDIR /src

# Copy the manifest files first to leverage Docker layer caching.
# The build context is the cloned mitre-attack/attack-navigator repo root.
COPY package.json package-lock.json* ./

# Install dependencies. Prefer a reproducible `npm ci` when a lockfile is
# present; fall back to `npm install` otherwise. Angular 19 peer deps require
# --legacy-peer-deps in the fallback path.
RUN if [ -f package-lock.json ]; then \
      npm ci; \
    else \
      npm install --legacy-peer-deps; \
    fi

# Copy the rest of the source and produce the static production bundle in dist/
COPY . .
RUN npm run build

# Runtime stage: serve the static build with nginx on port 4200 so the
# existing compose service (VIRTUAL_PORT=4200, expose 4200) keeps working.
FROM nginx:alpine
EXPOSE 4200

COPY --from=build /src/dist/ /usr/share/nginx/html/

# nginx config: listen on 4200 and fall back to index.html for SPA routing
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
    listen 4200;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
EOF
